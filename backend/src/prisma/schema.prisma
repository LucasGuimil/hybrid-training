generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id          String        @id @default(uuid())
  name        String
  image       String?
  category    String
  description String?
  muscleGroup String
  timeBased   Boolean       @default(false)
  setLogs     ExerciseSet[]
}

model WorkoutSession {
  id           String        @id @default(uuid())
  title        String?
  date         DateTime      @default(now())
  notes        String?
  duration     Int?
  exerciseSets ExerciseSet[]
}

model ExerciseSet {
  id          String         @id @default(uuid())
  reps        Int?
  weight      Float?
  restTime    Int?
  isCompleted Boolean        @default(false)
  exerciseId  String
  sessionId   String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  session     WorkoutSession @relation(fields: [sessionId], references: [id])
}
